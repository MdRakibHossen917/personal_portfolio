# Resend API Key for portfolio contact form email delivery
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Destination email inbox where inquiries should be delivered
# Example: rakibhossen.dev@gmail.com
CONTACT_EMAIL=rakibhossen.dev@gmail.com

# (Optional) Verified sender on Resend. 
# Defaults to onboarding@resend.dev until a custom domain is verified in Resend.
# If you verify your custom domain (e.g. mdrakibhossen.com) on Resend, you can use:
# RESEND_FROM_EMAIL="Md Rakib Hossen <contact@mdrakibhossen.com>"
RESEND_FROM_EMAIL="Portfolio Contact Form <onboarding@resend.dev>"
